<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/playerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:keepScreenOn="true"
    android:focusable="true"
    android:focusableInTouchMode="true"
    tools:context=".PlayerActivity">

    <androidx.media3.ui.PlayerView
        android:id="@+id/playerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:focusable="false" />

    <com.google.android.material.progressindicator.CircularProgressIndicator
        android:id="@+id/loadingSpinner"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminate="true"
        app:indicatorColor="@color/text_primary"
        app:indicatorSize="48dp"
        app:trackThickness="3dp"
        app:indicatorInset="0dp"
        app:trackCornerRadius="4dp"
        android:visibility="visible" />

    <!-- Mensaje grande cuando el canal no carga -->
    <TextView
        android:id="@+id/tvChannelUnavailable"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/channel_unavailable"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/error_text_size"
        android:shadowColor="#CC000000"
        android:shadowRadius="8"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivPauseIcon"
        android:layout_width="@dimen/player_icon_size"
        android:layout_height="@dimen/player_icon_size"
        android:layout_gravity="center"
        android:contentDescription="Pausa"
        android:src="@drawable/ic_pause"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/ivPlayIcon"
        android:layout_width="@dimen/player_icon_size"
        android:layout_height="@dimen/player_icon_size"
        android:layout_gravity="center"
        android:contentDescription="Reproducir"
        android:src="@drawable/ic_play"
        android:visibility="gone" />

    <TextView
        android:id="@+id/tvChannelNameOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|start"
        android:layout_marginStart="@dimen/overlay_channel_name_margin"
        android:layout_marginTop="@dimen/overlay_channel_name_margin"
        android:paddingHorizontal="16dp"
        android:paddingVertical="8dp"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/overlay_channel_name_size"
        android:shadowColor="#CC000000"
        android:shadowRadius="8"
        android:visibility="gone"
        tools:text="Canal de Prueba" />

    <TextView
        android:id="@+id/tvChannelNumberOsd"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/osd_margin"
        android:layout_marginEnd="@dimen/osd_margin"
        android:background="@drawable/bg_channel_number_osd"
        android:paddingHorizontal="@dimen/osd_padding_h"
        android:paddingVertical="@dimen/osd_padding_v"
        android:textColor="@color/text_primary"
        android:textSize="@dimen/osd_text_size"
        android:visibility="gone"
        tools:text="01" />

    <!-- Drawer IZQUIERDO: canales -->
    <LinearLayout
        android:id="@+id/sideDrawer"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@drawable/bg_side_drawer"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/tvChannelsHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/drawer_item_padding_h"
            android:paddingBottom="12dp"
            android:text="Canales"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <EditText
            android:id="@+id/etSearch"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginHorizontal="@dimen/drawer_item_padding_h"
            android:layout_marginBottom="8dp"
            android:background="@drawable/bg_search_field"
            android:hint="@string/search_hint"
            android:imeOptions="actionSearch"
            android:inputType="text"
            android:paddingHorizontal="18dp"
            android:singleLine="true"
            android:textColor="@color/text_primary"
            android:textColorHint="@color/text_muted"
            android:textSize="15sp" />

        <TextView
            android:id="@+id/tvFavoritesOption"
            android:layout_width="match_parent"
            android:layout_height="@dimen/drawer_item_height"
            android:background="@drawable/bg_drawer_item_selector"
            android:clickable="true"
            android:drawableEnd="@drawable/ic_chevron_right"
            android:drawablePadding="12dp"
            android:focusable="true"
            android:focusableInTouchMode="true"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/drawer_item_padding_h"
            android:text="@string/favorites"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/drawer_item_text_size" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvDrawerChannels"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="true"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <!-- Favoritos: aparece a la derecha del drawer de canales -->
    <LinearLayout
        android:id="@+id/favoritesDrawer"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:layout_marginStart="@dimen/drawer_width"
        android:background="@drawable/bg_favorites_drawer"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/tvFavoritesHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/drawer_item_padding_h"
            android:paddingBottom="12dp"
            android:text="@string/favorites"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <TextView
            android:id="@+id/tvFavoritesEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/drawer_item_padding_h"
            android:paddingVertical="16dp"
            android:text="@string/favorites_empty"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvFavorites"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="true"
            android:descendantFocusability="afterDescendants"
            android:focusable="true"
            android:focusableInTouchMode="true" />

    </LinearLayout>

    <!-- Drawer DERECHO: programación (EPG) -->
    <LinearLayout
        android:id="@+id/epgDrawer"
        android:layout_width="@dimen/drawer_width"
        android:layout_height="match_parent"
        android:layout_gravity="end"
        android:background="@drawable/bg_side_drawer_right"
        android:orientation="vertical"
        android:paddingTop="24dp"
        android:translationX="320dp"
        android:visibility="invisible">

        <TextView
            android:id="@+id/tvEpgHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/drawer_item_padding_h"
            android:paddingBottom="12dp"
            android:text="Programación"
            android:textColor="@color/text_primary"
            android:textSize="20sp" />

        <!-- Estado de carga del EPG -->
        <LinearLayout
            android:id="@+id/epgLoadingContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_horizontal"
            android:paddingVertical="24dp"
            android:visibility="gone">

            <com.google.android.material.progressindicator.CircularProgressIndicator
                android:id="@+id/epgLoadingSpinner"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:indeterminate="true"
                app:indicatorColor="@color/text_primary"
                app:indicatorSize="36dp"
                app:trackThickness="3dp"
                app:trackCornerRadius="4dp" />

            <TextView
                android:id="@+id/tvEpgLoadingText"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:text="@string/fetching_epg"
                android:textColor="@color/text_muted"
                android:textSize="15sp" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvEpgEmpty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingHorizontal="@dimen/drawer_item_padding_h"
            android:paddingVertical="16dp"
            android:text="Programación no disponible"
            android:textColor="@color/text_muted"
            android:textSize="15sp"
            android:visibility="gone" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvEpg"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:clipToPadding="false" />

    </LinearLayout>

</FrameLayout>
